# Postgres
POSTGRES_USER=beacon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beacon
POSTGRES_PORT=55432
DATABASE_URL=postgres://beacon:change-me@localhost:55432/beacon

# MinIO (S3-compatible object storage for photos)
MINIO_ROOT_USER=beacon
MINIO_ROOT_PASSWORD=change-me-too
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=beacon-photos

# Redis (BullMQ job queue)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend
PORT=4000
NODE_ENV=development

# Auth (Phase 2+)
JWT_SECRET=change-me-in-production

# Web Push VAPID keys (Phase 8+)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SMS aggregator (Phase 8+, adapter is pluggable)
SMS_AGGREGATOR_API_KEY=
