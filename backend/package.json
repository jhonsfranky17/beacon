{
  "name": "@beacon/backend",
  "private": true,
  "version": "0.1.0",
  "main": "./dist/index.js",
  "scripts": {
    "predev": "npm run build --workspace=@beacon/shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build --workspace=@beacon/shared",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@beacon/shared": "*",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
